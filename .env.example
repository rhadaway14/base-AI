# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_HOST=0.0.0.0
API_PORT=8000
AGENT_GATEWAY_URL=http://localhost:8100
CORS_ALLOW_ORIGINS=http://localhost:3000

# AI provider
# echo: deterministic local provider, no cloud credentials
# bedrock: wire a real provider adapter before enabling
LLM_PROVIDER=echo
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Couchbase
COUCHBASE_CONNECTION_STRING=couchbase://localhost
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=app

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
